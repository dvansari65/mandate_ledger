{
  "openapi": "3.1.0",
  "info": {
    "title": "mandate-ledger",
    "description": "The five calls over HTTP. `200`: allowed. `409`: refused, with the code. `503`: could not decide — read the context back, then retry. Every call is safe to repeat: a retry is the same purchase, and gets the same answer.",
    "license": {
      "name": "Apache-2.0"
    },
    "version": "0.0.1"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "The process is up.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "Up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "The process can reach its store. One check runs at a time; a second\ncaller while one is in flight is told to come back, so that nobody can\ndrain the pool through this door.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/authorizations": {
      "post": {
        "tags": [
          "lifecycle"
        ],
        "summary": "Check a cart against a mandate and reserve its total.",
