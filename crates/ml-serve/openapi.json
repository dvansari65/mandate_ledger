    "/v1/events": {
      "get": {
        "tags": [
          "read"
        ],
        "summary": "What happened: every event in every context, in commit order,\nrefusals included.",
        "operationId": "events",
        "parameters": [
          {
            "name": "after",
            "in": "path",
            "description": "Start just after this sequence number. Without it, the most recent\nevents. The response's `next` is the value to pass to read what\ncame after; `limit=0` gives `next` alone, which is where \"now\" is.",
            "required": true,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "path",
            "description": "At most this many events. Default 50, at most 500.",
            "required": true,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of the log",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResponse"
